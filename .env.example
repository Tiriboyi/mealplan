# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored: never commit a real key.

# Optional. Get a free key at https://www.prijsprofeet.nl/api
# Without a key the app still works, on PrijsProfeet's lower per-IP rate limits.
# You can also leave this empty and paste a key in the app's Settings instead.
PRIJSPROFEET_API_KEY=

# Optional. How PrijsProfeet can reach you about breaking changes; sent in the
# User-Agent, e.g. "you@example.com" or "+https://github.com/you/mealplan".
APP_CONTACT=

# Optional. Where the local copy of PrijsProfeet's promotions is kept.
# Defaults to .cache/prijsprofeet.db in the project folder.
MEALPLAN_DB=
